NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=12h

# MySQL
MYSQLHOST=127.0.0.1
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=change-me
MYSQLDATABASE=compliance_os
MYSQL_CONNECTION_LIMIT=10

# File uploads
UPLOAD_DIR=./uploads

# Frontend origin. For local use http://localhost:3000.
# For GitHub Pages use your exact Pages URL, e.g. https://YOUR_USERNAME.github.io/skydo-compliance-os
CORS_ORIGIN=http://localhost:3000

# Browser API URL. Used by the static GitHub Pages frontend.
PUBLIC_API_BASE_URL=http://localhost:3000

# Optional external integrations. Set only with official credentials/endpoints.
COMPLIANCE_PORTAL_BASE_URL=
COMPLIANCE_PORTAL_API_KEY=
METABASE_BASE_URL=
METABASE_API_KEY=
ZOHO_DESK_BASE_URL=https://desk.zoho.com/api/v1
ZOHO_DESK_ORG_ID=
ZOHO_DESK_ACCESS_TOKEN=
IDFY_BASE_URL=
IDFY_API_KEY=
FRAVITY_BASE_URL=
FRAVITY_API_KEY=
